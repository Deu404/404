# Copy to .env.local. Paths are relative to the project root.
VITE_ANOMALY_API_URL=/anomaly-results.json
# Frontend build setting: backend origin only (no /api/agent suffix).
# On Render, set this on the FRONTEND service, then rebuild and deploy.
# Leave unset for local Vite proxy or same-origin API hosting.
# VITE_AGENT_API_URL=https://your-agent-service.onrender.com
TEST_DATA_DIR=./test_data
ANOMALY_OBSERVATION_DIR=./test_data
# CSV fallback only: EQUIPMENT_DATA_DIR=./equipment-data
